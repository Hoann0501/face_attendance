# Face Attendance Deploy – Environment Variables
# Copy this file to .env and edit as needed.
# These values override the defaults in backend/config.py

# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Camera
CAMERA_INDEX=0
CAMERA_COOLDOWN_SECONDS=4

# Anti-spoofing thresholds
REAL_THRESHOLD_FACE=0.75
REAL_THRESHOLD_FULL=0.55
WINDOW_SIZE=7
MIN_REAL_VOTES=5

# Face verification
VERIFY_THRESHOLD=0.35
FACE_TOP_K=5
